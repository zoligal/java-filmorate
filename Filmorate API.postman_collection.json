{
  "info": {
    "_postman_id": "filmorate-fix-404-friendship",
    "name": "Filmorate API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "friends / Not friend remove",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/users/2/friends/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["users", "2", "friends", "1"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Should return 404 when friendship does not exist\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Response message should indicate missing friendship\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.contain(\"не существует\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
